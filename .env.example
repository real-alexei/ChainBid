# --- Chain ---
RPC_URL=http://localhost:8545
CHAIN_ID=31337
CONFIRMATIONS=5

# --- API ---
API_PORT=3000
JWT_SECRET=dev-only-change-me
SIWE_DOMAIN=localhost:5173

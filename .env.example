# Copy to .env for local development. Values match docker-compose.yml defaults.

# --- Postgres ---
POSTGRES_USER=chainbid
POSTGRES_PASSWORD=chainbid
POSTGRES_DB=chainbid
DATABASE_URL=postgresql://chainbid:chainbid@localhost:5432/chainbid

# --- Redis ---
